<Window x:Class="PhoneCtrl.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhoneCtrl"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Check for updates" Click="OnMenuCheckUpdates" />
            <MenuItem Header="Hide widget (click the tray icon to show it)" Click="OnMenuHide" />
            <Separator />
            <MenuItem Header="Exit PhoneCtrl" Click="OnMenuExit" />
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8C8C8C" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4,8,0,4" />
        </Style>

        <Style x:Key="PadButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2C2C2C" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D3D3D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0078D4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Arrows inside the video pad: grey until hovered, then they "pop". -->
        <Style x:Key="ArrowButton" TargetType="Button">
            <Setter Property="Foreground" Value="#5C5C5C" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White" />
                                <Setter TargetName="Bd" Property="Background" Value="#0078D4" />
                                <Setter TargetName="Cp" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.2" ScaleY="1.2" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#005A9E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UpdateButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#9A9A9A" />
            <Setter Property="Background" Value="#262626" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="3,10,3,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LockButton" TargetType="Button" BasedOn="{StaticResource PadButton}">
            <Setter Property="Background" Value="#B3261E" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D93025" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#7F1D17" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Collapsed: a slim tab on the screen edge. Hover to open, drag to move. -->
        <Border x:Name="Handle" Width="16" Height="80" CornerRadius="8"
                Background="#E61E1E1E" BorderBrush="#40FFFFFF" BorderThickness="1"
                MouseLeftButtonDown="OnDragStart" ToolTip="PhoneCtrl - hover to open, drag to move">
            <Grid>
                <StackPanel x:Name="HandleContent" Orientation="Vertical"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse x:Name="HandleDot" Width="7" Height="7" Fill="#8A8A8A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <!-- Live "audio is playing" indicator: bouncing bars while the iPhone plays something. -->
                    <StackPanel x:Name="Waveform" Orientation="Horizontal" Visibility="Collapsed" Height="10"
                                Margin="0,6,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Rectangle Width="2" Height="10" Margin="0.75,0" RadiusX="1" RadiusY="1" Fill="#2ECC71" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.4" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="2" Height="10" Margin="0.75,0" RadiusX="1" RadiusY="1" Fill="#2ECC71" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.4" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="2" Height="10" Margin="0.75,0" RadiusX="1" RadiusY="1" Fill="#2ECC71" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.4" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="2" Height="10" Margin="0.75,0" RadiusX="1" RadiusY="1" Fill="#2ECC71" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.4" /></Rectangle.RenderTransform>
                        </Rectangle>
                    </StackPanel>
                </StackPanel>
                <!-- green badge when an update is ready -->
                <Ellipse x:Name="UpdateBadge" Width="5" Height="5" Fill="#3FD13F" Visibility="Collapsed"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" />
            </Grid>
        </Border>

        <!-- Expanded panel -->
        <Border x:Name="ExpandedPanel" Visibility="Collapsed" CornerRadius="16" Padding="8"
                Background="#F21B1B1B" BorderBrush="#40FFFFFF" BorderThickness="1">
            <StackPanel>
                <DockPanel Background="Transparent" Margin="4,2,0,0" MouseLeftButtonDown="OnDragStart"
                           Cursor="SizeAll" ToolTip="Drag to move (snaps to any screen edge)">
                    <Button x:Name="MouseToPhoneButton" DockPanel.Dock="Right" Style="{StaticResource PadButton}"
                            Width="30" Height="30" FontSize="14" Margin="6,0,0,0"
                            Tag="MouseToPhone" Click="OnAction" Content="&#xE962;" />
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#8A8A8A" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Text="Starting…" Foreground="#DDDDDD" FontSize="12"
                               Margin="8,0,4,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <StackPanel x:Name="Sections" Orientation="Vertical">
                    <StackPanel x:Name="MusicSection">
                        <TextBlock Text="MUSIC" Style="{StaticResource SectionLabel}" />
                        <!-- Now playing on the iPhone (shown when the phone shares it) -->
                        <Grid x:Name="NowPlayingRow" Visibility="Collapsed" Margin="3,0,3,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="46" Height="46" CornerRadius="8" Background="#2C2C2C">
                                <Grid>
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8D6;" FontSize="18"
                                               Foreground="#6E6E6E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border x:Name="ArtworkView" CornerRadius="8" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TrackTitle" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="TrackArtist" Foreground="#A8A8A8" FontSize="11" Margin="0,1,0,0"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="TrackApp" Foreground="#6E6E6E" FontSize="10" Margin="0,1,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                        <UniformGrid Columns="3">
                            <Button Style="{StaticResource PadButton}" Tag="PreviousTrack" Click="OnAction" Content="&#xE892;" ToolTip="Previous song" />
                            <Button x:Name="PlayPauseButton" Style="{StaticResource PadButton}" Tag="PlayPause" Click="OnAction" Content="&#xE768;" ToolTip="Play / pause" />
                            <Button Style="{StaticResource PadButton}" Tag="NextTrack" Click="OnAction" Content="&#xE893;" ToolTip="Next song" />
                        </UniformGrid>
                    </StackPanel>

                    <StackPanel x:Name="VolumeSection">
                        <TextBlock Text="VOLUME" Style="{StaticResource SectionLabel}" />
                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource PadButton}" Tag="VolumeDown" Click="OnAction" Content="&#xE993;" ToolTip="Volume down" />
                            <Button Style="{StaticResource PadButton}" Tag="VolumeUp" Click="OnAction" Content="&#xE995;" ToolTip="Volume up" />
                        </UniformGrid>
                    </StackPanel>

                    <StackPanel x:Name="VideoSection">
                        <TextBlock Text="VIDEOS" Style="{StaticResource SectionLabel}" />
                        <!-- One pad: click an arrow, or scroll the mouse wheel anywhere on it. -->
                        <Border x:Name="VideoPad" Height="40" Margin="3" CornerRadius="10" Background="#2C2C2C"
                                MouseWheel="OnVideoPadWheel"
                                ToolTip="Click an arrow, or scroll your mouse wheel here, to change TikTok / Reels / Shorts videos">
                            <UniformGrid Columns="2">
                                <Button x:Name="PrevVideoButton" Style="{StaticResource ArrowButton}" Tag="PreviousVideo"
                                        Click="OnAction" Content="&#xE70E;" ToolTip="Previous video" />
                                <Button x:Name="NextVideoButton" Style="{StaticResource ArrowButton}" Tag="NextVideo"
                                        Click="OnAction" Content="&#xE70D;" ToolTip="Next video" />
                            </UniformGrid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="LockSection">
                        <TextBlock Text="PHONE" Style="{StaticResource SectionLabel}" />
                        <Button Style="{StaticResource LockButton}" Tag="Lock" Click="OnAction"
                                ToolTip="Lock the phone (screen goes black)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72E;" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="Lock phone" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Grey "Check for updates" → spinning while checking → blue "Update to vX" when one is ready. -->
                <Button x:Name="UpdateButton" Style="{StaticResource UpdateButtonStyle}" Click="OnUpdateClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="UpdateIcon" FontFamily="{StaticResource IconFont}" Text="&#xE895;" FontSize="13"
                                   VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="UpdateIconRotation" Angle="0" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="UpdateText" Text="Check for updates" FontFamily="Segoe UI" FontSize="12"
                                   FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <TextBlock x:Name="HotkeyHint" Foreground="#6E6E6E" FontSize="10" Margin="4,6,4,2" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
